# Server Port
PORT=5000

# Client & Server Base URLs
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Google OAuth 2.0 Credentials
# Get them from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth App Credentials
# Get them from GitHub -> Settings -> Developer settings -> OAuth Apps
# Authorization callback URL: http://localhost:5000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email Service Configuration (Resend)
# Get your free API key at https://resend.com -> API Keys
RESEND_API_KEY=
# Optional: custom sender (defaults to onboarding@resend.dev)
EMAIL_FROM=PrepStack <onboarding@resend.dev>
