# Server Port
PORT=5000

# Client & Server Base URLs
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Google OAuth 2.0 Credentials
# Get them from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth App Credentials
# Get them from GitHub -> Settings -> Developer settings -> OAuth Apps
# Authorization callback URL: http://localhost:5000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email Service Configuration (Option A: Resend API)
# Get your free API key at https://resend.com -> API Keys
# Note: Free Resend test domain (onboarding@resend.dev) only delivers to your Resend account email.
# To send to ANY student email worldwide without sandbox restrictions, use Option B (Gmail SMTP) below!
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=PrepStack <onboarding@resend.dev>

# Email Service Configuration (Option B: Gmail SMTP - No Custom Domain Required!)
# Works with your regular personal @gmail.com address to deliver real emails to all students:
# 1. Enable 2-Step Verification in your Google Account (myaccount.google.com/security)
# 2. Go to myaccount.google.com/apppasswords and create an App Password (name it "PrepStack")
# 3. Paste your Gmail and the 16-character App Password below:
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
